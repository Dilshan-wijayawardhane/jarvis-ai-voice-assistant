# LLM Configuration
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# JARVIS Configuration
WAKE_WORD=jarvis
TTS_VOICE=en-US-JennyNeural
MAX_CONVERSATION_HISTORY=10
VOICE_ENABLED=true
WAKE_WORD_ENABLED=true

# Audio Configuration
MICROPHONE_INDEX=0
SAMPLE_RATE=16000
CHUNK_SIZE=1024